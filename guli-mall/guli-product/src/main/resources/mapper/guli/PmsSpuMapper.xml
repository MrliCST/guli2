<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
    PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.atlearn.guli.mapper.PmsSpuMapper">

    <resultMap id="groupWithAttrsMap" type="com.atlearn.guli.domain.vo.PmsAttrGroupWithAttrsVo">
        <id property="attrGroupId" column="attr_group_id"/>
        <result property="attrGroupName" column="attr_group_name"/>
        <result property="sort" column="sort"/>
        <result property="descript" column="descript"/>
        <result property="icon" column="group_icon"/>
        <result property="catelogId" column="catelog_id"/>
        <collection property="attrs" ofType="com.atlearn.guli.domain.vo.PmsAttrVo">
            <id property="attrId" column="attr_id"/>
            <result property="attrName" column="attr_name"/>
            <result property="searchType" column="search_type"/>
            <result property="valueType" column="value_type"/>
            <result property="icon" column="attr_icon"/>
            <result property="valueSelect" column="value_select"/>
            <result property="attrType" column="attr_type"/>
            <result property="enable" column="enable"/>
            <result property="catelogId" column="attr_catelog_id"/>
            <result property="showDesc" column="show_desc"/>
        </collection>
    </resultMap>

    <!-- 根据分类id查询属性分组及其属性列表 -->
    <select id="selectAttrGroupsWithAttrs" resultMap="groupWithAttrsMap">
        SELECT
            ag.attr_group_id,
            ag.attr_group_name,
            ag.sort,
            ag.descript,
            ag.icon AS group_icon,
            ag.catelog_id,
            a.attr_id,
            a.attr_name,
            a.search_type,
            a.value_type,
            a.icon AS attr_icon,
            a.value_select,
            a.attr_type,
            a.enable,
            a.catelog_id AS attr_catelog_id,
            a.show_desc,
            aar.attr_sort
        FROM pms_attr_group ag
        LEFT JOIN pms_attr_attrgroup_relation aar ON ag.attr_group_id = aar.attr_group_id
        LEFT JOIN pms_attr a ON aar.attr_id = a.attr_id AND a.catelog_id = #{catelogId}
        WHERE ag.catelog_id = #{catelogId}
        ORDER BY ag.attr_group_id, aar.attr_sort
    </select>

</mapper>
