{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "node",
            "name": "RuoYi UI: 启动",
            "request": "launch",
            "runtimeExecutable": "npm",
            "runtimeArgs": ["run", "dev"],
            "cwd": "${workspaceFolder}/ruoyi-ui",
            "console": "integratedTerminal"
        },
        {
            "type": "java",
            "name": "优惠券服务",
            "request": "launch",
            "mainClass": "com.atlearn.guli.GuliCouponApplication",
            "projectName": "guli-coupon",
            "vmArgs": "-Dfile.encoding=UTF-8",
            "console": "integratedTerminal"
        },
        {
            "type": "java",
            "name": "会员服务",
            "request": "launch",
            "mainClass": "com.atlearn.guli.GuliMemberApplication",
            "projectName": "guli-member",
            "vmArgs": "-Dfile.encoding=UTF-8",
            "console": "integratedTerminal"
        },
        {
            "type": "java",
            "name": "订单服务",
            "request": "launch",
            "mainClass": "com.atlearn.guli.GuliOrderApplication",
            "projectName": "guli-order",
            "vmArgs": "-Dfile.encoding=UTF-8",
            "console": "integratedTerminal"
        },
        {
            "type": "java",
            "name": "商品服务",
            "request": "launch",
            "mainClass": "com.atlearn.guli.GuliProductApplication",
            "projectName": "guli-product",
            "vmArgs": "-Dfile.encoding=UTF-8 -Ddubbo.resolve.file=guli-mall/guli-product/src/main/resources/dubbo-resolve.properties",
            "console": "integratedTerminal"
        },
        {
            "type": "java",
            "name": "仓储服务",
            "request": "launch",
            "mainClass": "com.atlearn.guli.GuliWareApplication",
            "projectName": "guli-ware",
            "vmArgs": "-Dfile.encoding=UTF-8 -Ddubbo.resolve.file=guli-mall/guli-ware/src/main/resources/dubbo-resolve.properties",
            "console": "integratedTerminal"
        }
    ]
}
